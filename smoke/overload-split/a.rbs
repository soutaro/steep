class Calc
  def plus: (Integer) -> Integer
          | (Float) -> Float
          | (String) -> String

  def pair: (Integer, Integer) -> :ii
          | (Integer, String) -> :is
          | (String, Integer) -> :si
          | (String, String) -> :ss

  def scale: (by: Integer) -> Integer
           | (by: Float) -> Float
end

class Store[Elem]
  def get: (Integer) -> Elem
         | (Range[Integer]) -> Array[Elem]?
end

class Tagger
  def tag: (Integer) -> String
         | (Numeric) -> Symbol

  def widen: (Integer) -> Integer
           | (Numeric) -> Numeric
end

interface _TagSymbol
  def tag: (Integer) -> Symbol
end

interface _TagBoth
  def tag: (Numeric) -> (String | Symbol)
end
