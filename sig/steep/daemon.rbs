module Steep
  module Daemon
    SOCKET_DIR: String

    LARGE_LOG_FILE_THRESHOLD: Integer

    # Module-level class methods for daemon lifecycle management
    self.@config: Configuration

    def self.config: () -> Configuration

    def self.project_id: () -> String

    def self.socket_path: () -> String

    def self.pid_path: () -> String

    def self.log_path: () -> String

    # Returns true when something is serving the socket, whether it is a daemon or a language server
    def self.running?: () -> bool


    def self.starting?: () -> bool

    def self.cleanup: () -> void

    def self.start: (stderr: IO) -> bool

    def self.stop: (stderr: IO) -> void

    def self.status: (stderr: IO) -> void

    private

    # The pid recorded in `path`, when the file exists and that process is alive
    def self.live_pid: (String path) -> Integer?

    def self.run_server: (stderr: IO) -> void

    def self.load_project: () -> Project
  end
end
