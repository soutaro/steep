module Steep
  module Services
    # SignatureService takes care of two sets of RBS files.
    #
    # 1. RBS files loaded from `EnvironmentLoader` -- usually type signatures of libraries
    # 2. RBS files managed in editors -- usually type signatures of the development target (app or gem)
    #
    # The files in #2 are managed through `#status` and the changes are tracked.
    #
    class SignatureService
      type status = SyntaxErrorStatus | AncestorErrorStatus | LoadedStatus

      attr_reader status: status

      class SyntaxErrorStatus
        attr_reader files: Hash[Pathname, file_status]

        attr_reader changed_paths: Set[Pathname]

        attr_reader diagnostics: Array[Diagnostic::Signature::Base]

        attr_reader last_builder: RBS::DefinitionBuilder

        @constant_resolver: RBS::Resolver::ConstantResolver?

        def initialize: (files: Hash[Pathname, file_status], changed_paths: Set[Pathname], diagnostics: Array[Diagnostic::Signature::Base], last_builder: RBS::DefinitionBuilder) -> void

        def constant_resolver: () -> RBS::Resolver::ConstantResolver
      end

      class AncestorErrorStatus
        attr_reader files: Hash[Pathname, file_status]

        attr_reader changed_paths: Set[Pathname]

        attr_reader diagnostics: Array[Diagnostic::Signature::Base]

        attr_reader last_builder: RBS::DefinitionBuilder

        @constant_resolver: RBS::Resolver::ConstantResolver?

        def initialize: (files: Hash[Pathname, file_status], changed_paths: Set[Pathname], diagnostics: Array[Diagnostic::Signature::Base], last_builder: RBS::DefinitionBuilder) -> void

        def constant_resolver: () -> RBS::Resolver::ConstantResolver
      end

      class LoadedStatus
        attr_reader files: Hash[Pathname, file_status]

        attr_reader builder: RBS::DefinitionBuilder

        attr_reader implicitly_returns_nil: bool

        @subtyping: Subtyping::Check?

        @constant_resolver: RBS::Resolver::ConstantResolver?

        def initialize: (files: Hash[Pathname, file_status], builder: RBS::DefinitionBuilder, implicitly_returns_nil: bool) -> void

        def subtyping: () -> Subtyping::Check

        def constant_resolver: () -> RBS::Resolver::ConstantResolver
      end

      # A file has one of the three states:
      #
      # 1. The parsing succeeded and loaded a list of declarations (RBS::Source::RBS)
      # 2. The content has a syntax error and parsing failed (ParsingError)
      # 3. Other unexpected error (UnexpectedError)
      #
      class RBSFileStatus
        attr_reader path: Pathname

        attr_reader content: String

        attr_reader source: RBS::Source::RBS | Diagnostic::Signature::UnexpectedError | RBS::ParsingError

        def initialize: (
          path: Pathname,
          content: String,
          source: RBS::Source::RBS | Diagnostic::Signature::UnexpectedError | RBS::ParsingError
        ) -> void
      end

      type file_status = RBSFileStatus | RBS::Source::Ruby

      attr_reader implicitly_returns_nil: bool

      # The resolution of the type names of the sources of `latest_env`
      #
      # The records tell the files to resolve again when type names are added or removed. The resolution is replaced
      # with the environment, so that the error statuses keep the one of the last loaded environment.
      #
      attr_reader resolution: TypeNameResolution

      # The paths of the library RBS files of the environment
      #
      # The libraries are the core, the stdlib and gem RBS files, and the signature directories given to the loader.
      # The files of the target are not included.
      #
      attr_reader env_rbs_paths: Set[Pathname]

      def initialize: (status: status, implicitly_returns_nil: bool, resolution: TypeNameResolution, env_rbs_paths: Set[Pathname]) -> void

      # Loads the libraries of the loader to a new environment
      #
      # If a library file has a syntax error, the environment has the core libraries only, and the status is
      # `SyntaxErrorStatus` with the error.
      #
      def self.load_from: (RBS::EnvironmentLoader loader, implicitly_returns_nil: bool) -> SignatureService

      # Returns the paths of the library RBS files the loader loads, without parsing them
      #
      # The paths are the ones `#load_from` finds in the environment.
      #
      def self.library_paths: (RBS::EnvironmentLoader loader) -> Set[Pathname]

      # Returns a new service whose environment has the libraries of `library_paths` and the files of `changes`, built
      # from the environment of this service
      #
      # The environment of a target is mostly the environment of another target: the libraries are the same except a few,
      # and the files of the targets are shared unless the target is unreferenced. Deriving the environment loads the
      # library files that this environment doesn't have, and the files whose contents are different, and resolves the
      # type names of them and of the files affected by the changes. The other sources are shared with this environment.
      #
      # Returns `nil` if the environment cannot be derived: this service is not loaded, a file has a syntax error, or
      # the environment has an error. The service is built from the libraries then.
      #
      def derive: (library_paths: Set[Pathname], changes: Server::ChangeBuffer::changes, implicitly_returns_nil: bool) -> SignatureService?

      # Returns `true` if the file has the content
      #
      def same_content?: (file_status file, String content) -> bool

      # Yield all RBS paths in the environment, both dependency RBS and target RBS
      #
      def each_rbs_path: () { (Pathname) -> void } -> void
                       | () -> Enumerator[Pathname, void]

      # The Target files
      #
      def files: () -> Hash[Pathname, file_status]

      def pending_changed_paths: () -> Set[Pathname]

      def latest_env: () -> RBS::Environment

      # Returns the source of the file in the latest environment, or `nil` if the environment doesn't have it
      #
      # The buffer of a file of the project is named by its relative path, and the one of a library by its absolute path.
      #
      def latest_source: (Pathname path) -> (RBS::Source::RBS | RBS::Source::Ruby | nil)

      # Parses the content of an RBS file, and resolves the type names in the latest environment
      #
      # Returns the error of a content that cannot be parsed. The environment is not changed: the source is for the
      # validation of a content the environment doesn't have.
      #
      def resolve_source: (Pathname path, String content) -> (RBS::Source::RBS | RBS::ParsingError | Diagnostic::Signature::UnexpectedError)

      def latest_builder: () -> RBS::DefinitionBuilder

      def latest_constant_resolver: () -> RBS::Resolver::ConstantResolver

      def current_subtyping: () -> Subtyping::Check?

      def apply_changes: (Hash[Pathname, file_status] files, Server::ChangeBuffer::changes changes) -> Hash[Pathname, file_status]

      def load_rbs_file: (Pathname path, String old_content, Array[ContentChange]) -> RBSFileStatus

      def parse_rbs_file: (Pathname path, String content) -> RBSFileStatus

      def load_ruby_file: (Pathname path, String old_content, Array[ContentChange]) -> RBS::Source::Ruby

      def parse_ruby_file: (Pathname path, String content) -> RBS::Source::Ruby

      # Returns the source of a loaded file
      #
      def file_source: (file_status file) -> RBS::Source::t

      # Returns `true` if `file_status` represents an error status
      #
      def error_file?: (file_status) -> bool

      # The entry point to apply the edit to the signatures
      #
      # Returns the paths of the other files whose type names are resolved to different names with the edit. The paths
      # are empty if the environment is not updated because of errors: the next update resolves them.
      #
      # The paths are the names of the buffers: the relative paths of the files of the project, and the absolute paths
      # of the libraries.
      #
      def update: (Server::ChangeBuffer::changes changes) -> Set[Pathname]

      # Replaces the sources of `paths` in the latest environment with `sources`, and returns the ancestor builder of the
      # updated environment, the paths of the other files whose type names are resolved to different names, and the
      # resolution of the environment
      #
      # `paths` are the paths of the sources removed from the environment, and of `sources`. Returns the errors, no
      # paths, and `nil` if the environment cannot be updated.
      #
      # The files whose type names may resolve to different names with the changes are resolved again, from the sources
      # of the project files, and the library files parsed again.
      #
      def update_env: (
        Set[Pathname] paths,
        Array[RBS::Source::t] sources
      ) -> [RBS::DefinitionBuilder::AncestorBuilder | Array[Diagnostic::Signature::Base], Set[Pathname], TypeNameResolution?]

      # Returns the sources of the paths in the latest environment, before the type name resolution
      #
      # The project files keep the parsed sources, and the library files are parsed again.
      #
      def unresolved_sources: (Set[Pathname] paths) -> Array[RBS::Source::t]

      # Returns the paths whose declarations in `env` are different from the ones in the latest environment
      #
      def changed_paths: (Set[Pathname] paths, env: RBS::Environment) -> Set[Pathname]

      def rescue_rbs_error: (Array[RBS::BaseError] errors) { () -> void } -> void

      def update_builder: (ancestor_builder: RBS::DefinitionBuilder::AncestorBuilder, paths: Set[Pathname]) -> RBS::DefinitionBuilder

      def type_names: (paths: Set[Pathname], env: RBS::Environment) -> Set[RBS::TypeName]

      def const_decls: (paths: Set[Pathname], env: RBS::Environment) -> Hash[RBS::TypeName, RBS::Environment::ConstantEntry]

      def global_decls: (paths: Set[Pathname], ?env: RBS::Environment) -> Hash[Symbol, RBS::Environment::GlobalEntry]

      def type_name_from_decl: (RBS::AST::Declarations::t decl, set: Set[RBS::TypeName]) -> void

      def add_descendants: (graph: RBS::AncestorGraph, names: Set[RBS::TypeName], set: Set[RBS::TypeName]) -> void

      def add_nested_decls: (env: RBS::Environment, names: Set[RBS::TypeName], set: Set[RBS::TypeName]) -> void
    end
  end
end
