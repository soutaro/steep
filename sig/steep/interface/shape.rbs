use Steep::TypeInference::MethodCall::MethodDecl

module Steep
  module Interface
    class Shape
      class MethodOverload
        attr_reader method_type: MethodType

        attr_reader method_defs: Array[RBS::Definition::Method::TypeDef]

        def initialize: (MethodType, Array[RBS::Definition::Method::TypeDef]) -> void

        # Returns an overload with the substitution applied to the method type
        #
        # Returns `self` when the method type is unchanged.
        #
        def subst: (Substitution) -> MethodOverload

        def method_decls: (Symbol) -> Array[MethodDecl]
      end

      class Entry
        @private_method: bool

        @overloads: Array[MethodOverload]?

        @generator: (^() -> Array[MethodOverload]?)?

        attr_reader method_name: Symbol

        def initialize: (method_name: Symbol, overloads: Array[MethodOverload], private_method: bool) -> void
                      | (method_name: Symbol, private_method: bool) { () -> Array[MethodOverload]? } -> void

        def has_method_type?: () -> bool

        def to_s: () -> String

        def private_method?: () -> bool

        def public_method?: () -> bool

        def overloads: () -> Array[MethodOverload]

        def method_types: () -> Array[MethodType]

        def force: () -> void
      end

      # The entries of the methods of a RBS definition
      #
      # It works like `Hash[Symbol, Entry]`, but builds each entry when it is requested --
      # the method of the definition is resolved and its method types are converted then.
      #
      class DefinitionEntries
        # The methods of a RBS definition
        #
        # It is the table that resolves a method when it is requested, or a hash of the methods.
        #
        interface _DefinitionMethods
          def []: (Symbol) -> RBS::Definition::Method?

          def key?: (Symbol) -> bool

          def each_key: () { (Symbol) -> void } -> untyped

          def each: () { ([Symbol, RBS::Definition::Method]) -> void } -> untyped
        end

        attr_reader methods: _DefinitionMethods

        # The entries built so far, that are shared with the entries of the public methods
        @entries: Hash[Symbol, Entry]

        @public_only: bool

        @block: ^(Symbol, RBS::Definition::Method) -> Entry

        def initialize: (_DefinitionMethods methods, ?entries: Hash[Symbol, Entry], ?public_only: bool) { (Symbol, RBS::Definition::Method) -> Entry } -> void

        # Returns `true` if the method is defined, without building the entry
        #
        def key?: (Symbol) -> bool

        # Returns the entry of the method, building it if it is not built yet
        #
        def []: (Symbol) -> Entry?

        def fetch: (Symbol) -> Entry

        # Returns `true` if the method is private, without building the entry
        #
        def private_method?: (Symbol) -> bool

        def each_key: () { (Symbol) -> void } -> void
                    | () -> Enumerator[Symbol, void]

        # Returns the entries of the public methods, that share the entries with `self`
        #
        def public_entries: () -> DefinitionEntries
      end

      class Methods
        def []=: (Symbol, Entry) -> Entry

        def []: (Symbol) -> Entry?

        def key?: (Symbol) -> bool

        def each: () { ([Symbol, Entry]) -> void } -> void
                | () -> Enumerator[[Symbol, Entry], void]

        # Yields the name of each method that has an entry, without resolving the entries
        #
        def each_name: () { (Symbol) -> void } -> void
                     | () -> Enumerator[Symbol, void]

        include Enumerable[[Symbol, Entry]]

        attr_reader substs: Array[Substitution]

        # The entries without the substitutions applied
        #
        # The entries of the methods of a RBS definition are built when they are requested.
        #
        attr_reader methods: Hash[Symbol, Entry] | DefinitionEntries
        attr_reader resolved_methods: Hash[Symbol, Entry?]

        def initialize: (substs: Array[Substitution], methods: Hash[Symbol, Entry] | DefinitionEntries) -> void

        # Returns `true` if the method is private, without resolving the entry
        #
        def private_method?: (Symbol) -> bool

        @subst: Substitution?
        def subst: () -> Substitution

        def push_substitution: (Substitution) -> Methods

        # Copies the entries of `other` into `self`
        #
        # The copied entries are lazy -- the substitutions of `other` are applied when the
        # entry is used. The block, if given, decides which entry survives when `self`
        # already has an entry of the method, and receives the new entry unresolved.
        #
        def merge!: (Methods other) ?{ (Symbol name, Entry old_entry, Entry new_entry) -> Entry } -> void

        def public_methods: () -> Methods
      end

      attr_reader type: AST::Types::t

      attr_reader methods: Methods

      @private: bool

      def initialize: (type: AST::Types::t, private: bool, ?methods: Methods?) -> void

      def update: (?type: AST::Types::t, ?methods: Methods) -> self

      def private?: () -> bool

      def public?: () -> bool

      def subst: (Substitution, ?type: AST::Types::t?) -> Shape

      def public_shape: () -> Shape

      @public_shape: Shape?
    end
  end
end
