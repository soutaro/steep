module Steep
  module TypeInference
    class LogicTypeInterpreter
      class Result
        attr_reader env: TypeEnv

        attr_reader type: AST::Types::t

        # `true` when the verdict is `empty`
        attr_accessor unreachable: bool

        # The emptiness of the type of the branch
        attr_accessor verdict: SetTheoretic::Verdict

        # The verdict is `empty` when `unreachable`, `inhabited` otherwise, unless given
        def initialize: (env: TypeEnv, type: AST::Types::t, ?unreachable: bool, ?verdict: SetTheoretic::Verdict?) -> void

        def update_env: () { () -> TypeEnv } -> Result

        def update_type: { () -> AST::Types::t } -> Result

        # Make the instance unreachable, and returns self
        #
        def unreachable!: () -> self

        # `true` if the branch is unreachable as long as the class hierarchy is what the RBS environment declares
        def unreachable_in_rbs?: () -> bool
      end

      # Receiver local variable of `x[:key]` and the literal discriminant types of each member of its union type
      #
      # `nil` key types mean the member must be kept whatever the narrowed type is.
      #
      class RecordDiscriminant
        attr_reader name: Symbol

        attr_reader entries: Array[[AST::Types::t, Array[AST::Types::t]?]]

        def initialize: (name: Symbol, entries: Array[[AST::Types::t, Array[AST::Types::t]?]]) -> void
      end

      TRUE: AST::Types::Literal

      FALSE: AST::Types::Literal

      BOOL: AST::Types::Boolean

      BOT: AST::Types::Bot

      UNTYPED: AST::Types::Any

      # The falsy values: `nil | false`
      FALSY: AST::Types::t

      # The narrowed types of the truthy branch and the falsy branch, with the verdicts of the branches
      type narrowing = [AST::Types::t, AST::Types::t, SetTheoretic::Verdict, SetTheoretic::Verdict]

      attr_reader subtyping: Subtyping::Check

      attr_reader typing: Typing

      attr_reader factory (): AST::Types::Factory

      attr_reader config: Interface::Builder::Config

      def initialize: (subtyping: Subtyping::Check, typing: Typing, config: Interface::Builder::Config) -> void

      def emptiness: () -> SetTheoretic::Emptiness

      def simplifier: () -> SetTheoretic::Simplifier

      # The upper bounds of the type variables in scope
      def bounds: () -> Hash[Symbol, AST::Types::t?]

      # The values of `type` that are in `predicate` and the ones that are not, with the verdicts of the two branches
      #
      # `negative` is the type the falsy branch excludes, `predicate` unless given.
      def narrow: (AST::Types::t `type`, AST::Types::t predicate, ?negative: AST::Types::t) -> narrowing

      # The truthy values of `type` and the falsy ones
      #
      # `bool` and the logic types stay on both sides as they are.
      def truthiness: (AST::Types::t `type`) -> narrowing

      # Narrows `type` by `is_a?(klass)`
      def type_case: (AST::Types::t `type`, RBS::TypeName klass) -> narrowing

      # The literal type of a literal node; `nil` for the other nodes
      def literal_type: (Parser::AST::Node node) -> AST::Types::t?

      def eval: (env: TypeEnv, node: Parser::AST::Node) -> [Result, Result]

      def evaluate_node: (env: TypeEnv, node: Parser::AST::Node, ?type: AST::Types::t) -> [Result, Result]

      def evaluate_method_call: (env: TypeEnv, type: AST::Types::Logic::Base, receiver: Parser::AST::Node?, arguments: Array[Parser::AST::Node]) -> [Result, Result]?

      def evaluate_union_method_call: (node: Parser::AST::Node, type: AST::Types::t, env: TypeEnv, receiver: Parser::AST::Node, receiver_type: AST::Types::Union) -> [Result, Result]?

      # Apply type refinement to `node` as `truthy_type` and `falsy_type`.
      #
      # This is done by top-down manner.
      #
      # Assigns given two types to the node when:
      #
      # * `node` is a `lvar`
      # * `node` is a `lvasgn`
      # * `node` is a _pure_ method call
      #
      def refine_node_type: (env: TypeEnv, node: Parser::AST::Node, truthy_type: AST::Types::t, falsy_type: AST::Types::t) -> [TypeEnv, TypeEnv]

      # Returns a pair of a node and set of local variable names.
      #
      # * The returned node is called _value node_ that is a node the value of given `node` can be taken from
      # * The local variable names are local variables that have the same value of the _value node_.
      #
      # ```ruby
      # a = 123   # `123` is the _value node_
      #           # :a is included in the set because `a` has the same value of _value node_
      #
      # c = b = a  # `a` is the _value node_, a set of { :b, :c } will be returned
      # ```
      #
      def decompose_value: (Parser::AST::Node node) -> [Parser::AST::Node, Set[Symbol]]

      def refine_pure_call: (TypeEnv env, Parser::AST::Node node, AST::Types::t type, ?RecordDiscriminant? discriminant) -> TypeEnv

      private

      def record_discriminant: (TypeEnv env, Parser::AST::Node node) -> RecordDiscriminant?

      def discriminant_key_types: (AST::Types::t member, Symbol | String key) -> Array[AST::Types::t]?

      def narrow_record_receiver: (RecordDiscriminant discriminant, AST::Types::t type) -> AST::Types::t?

      def union_members: (AST::Types::t? `type`, ?Set[RBS::TypeName] visited) -> Array[AST::Types::t]?

      def disjoint?: (Array[AST::Types::t] key_types, Array[AST::Types::t] type_expanded) -> bool

      # Assign local variables included in the assignment node and masgn node
      #
      def evaluate_assignment: (Parser::AST::Node node, TypeEnv env, AST::Types::t rhs_type) -> TypeEnv

      def guess_type_from_method: (Parser::AST::Node node) -> (AST::Types::Logic::ReceiverIsArg | AST::Types::Logic::ReceiverIsNil | AST::Types::Logic::Not | AST::Types::Logic::ArgIsReceiver | nil)

      # Narrows `type` by `is_a?(klass)`: the truthy type and the falsy type, `nil` when the branch is unreachable
      def type_case_select: (AST::Types::t `type`, RBS::TypeName klass) -> [AST::Types::t?, AST::Types::t?]

      def try_convert: (AST::Types::t, Symbol) -> AST::Types::t?

      def no_subtyping?: (sub_type: AST::Types::t, super_type: AST::Types::t) -> Subtyping::Result::t?

      def subtyping?: (sub_type: AST::Types::t, super_type: AST::Types::t) -> bool
    end
  end
end
