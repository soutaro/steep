module Steep
  module Drivers
    class Langserver
      attr_reader stdout: IO

      attr_reader stderr: IO

      attr_reader stdin: IO

      attr_reader write_mutex: Thread::Mutex

      attr_reader type_check_queue: Thread::Queue

      attr_reader type_check_thread: Thread

      attr_reader jobs_option: Utils::JobsOption

      attr_accessor command_socket: bool

      include Utils::DriverHelper

      def initialize: (stdout: untyped, stderr: untyped, stdin: untyped) -> void

      @writer: LanguageServer::Protocol::Transport::Io::Writer?

      # The writer to the client, on a duplicate of `stdout`
      #
      def writer: () -> LanguageServer::Protocol::Transport::Io::Writer

      @reader: LanguageServer::Protocol::Transport::Io::Reader?

      # The reader from the client, on a duplicate of `stdin`
      #
      # The server never reads the standard input itself: spawning a worker without `fork`
      # redirects the fds 0 and 1 of the server while the child starts, and the redirection
      # waits for the thread that is blocked reading the fd.
      #
      def reader: () -> LanguageServer::Protocol::Transport::Io::Reader

      @project: Project
      def project: () -> Project

      def run: () -> Integer

      # Starts accepting `steep query`/`steep check` connections on the UNIX socket
      #
      # Returns `nil` when the command socket is disabled, is not supported on the platform,
      # or is already served by another process.
      #
      def start_command_socket: (Server::Master master) -> Server::CommandSocket?
    end
  end
end
