module Steep
  module Drivers
    module Utils
      class JobsOption
        attr_accessor jobs_count: Integer?

        attr_accessor steep_command: String?

        attr_reader jobs_count_modifier: Integer

        def initialize: (?jobs_count_modifier: Integer) -> void

        def default_jobs_count: () -> Integer

        def jobs_count_value: () -> Integer

        # The launcher of the workers: `ForkLauncher` where `fork` is available and no `steep_command` is given,
        # `SpawnLauncher` otherwise
        def worker_launcher: (project: Project, interaction: bool, ?patterns: Array[String], ?typecheck_count: Integer) -> Server::_WorkerLauncher
      end
    end
  end
end
