use LanguageServer::Protocol::Transport::Io::*, Thread::Queue
use Steep::Services::CompletionProvider, Steep::Services::HoverProvider

module Steep
  module Server
    # The interaction worker answers the hover, completion, signature help, and source symbol requests of the master
    #
    # It type checks the file on demand and returns what is at the position, with the types as strings and the
    # declarations as names. The master renders the documentation from its own environment.
    #
    class InteractionWorker < BaseWorker
      include ChangeBuffer

      class HoverJob
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader line: Integer

        attr_reader column: Integer

        def initialize: (id: String, path: Pathname, line: Integer, column: Integer) -> void
      end

      class CompletionJob
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader line: Integer

        attr_reader column: Integer

        attr_reader trigger: String?

        def initialize: (id: String, path: Pathname, line: Integer, column: Integer, trigger: String?) -> void
      end

      class SignatureHelpJob
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader line: Integer

        attr_reader column: Integer

        def initialize: (id: String, path: Pathname, line: Integer, column: Integer) -> void
      end

      # Resolves what is at a position for `$/steep/source/symbol`
      class SourceSymbolJob
        attr_reader id: String

        # Absolute path of the file
        attr_reader path: Pathname

        attr_reader line: Integer

        attr_reader column: Integer

        def initialize: (id: String, path: Pathname, line: Integer, column: Integer) -> void
      end

      type job = HoverJob | CompletionJob | SignatureHelpJob | SourceSymbolJob

      attr_reader service: Services::TypeCheckService

      attr_reader mutex: Mutex

      def initialize: (project: Project, reader: Reader, writer: Writer, ?queue: Queue) -> void

      def handle_job: (job) -> void

      @last_job_mutex: Mutex

      @last_job: job?

      def process_latest_job: [T] (job) { () -> T } -> T?

      def queue_job: (job) -> void

      type lsp_request = { id: String, method: String, params: untyped }

      def handle_request: (lsp_request) -> void

      # Returns what is at the position of the job, `nil` when nothing is there
      def process_hover: (HoverJob job) -> CustomMethods::Hover::result?

      # Translates a hover content to the wire, with the types as strings and the declarations as names
      def hover_content: (HoverProvider::Ruby::content | HoverProvider::RBS::content) -> CustomMethods::Hover::content

      # The name a class or module declaration declares
      def declared_type_name: (HoverProvider::ClassTypeContent::decl) -> RBS::TypeName

      # Returns what is at the position of the job, type checking the file on demand like hover
      def process_source_symbol: (SourceSymbolJob job) -> CustomMethods::Source__Symbol::result

      # Returns the completion candidates at the position of the job, `nil` when the file is not in the project
      def process_completion: (CompletionJob job) -> CustomMethods::Completion::result?

      def completion_item: (CompletionProvider::item item) -> CustomMethods::Completion::item

      # The builtin types of RBS, like `untyped`, as candidates replacing the `prefix_size` characters before the position
      def builtin_type_items: (Integer prefix_size, Integer line, Integer column) -> Array[CustomMethods::Completion::item]

      # The range of the `prefix_size` characters before the position
      def range_before: (Integer line, Integer column, Integer prefix_size) -> CustomMethods::range

      # Returns the signature help at the position of the job, `nil` when the file is not in the project
      def process_signature_help: (SignatureHelpJob) -> CustomMethods::SignatureHelp::result?

      # The target of a Ruby or RBS file of the project
      def target_for: (Pathname) -> Project::Target?
    end
  end
end
