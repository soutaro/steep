module Steep
  module Server
    # A launcher starts the workers of a master, and attaches them with `Master#attach_worker`
    #
    # `Master#start` calls `#start` once before it starts serving, and `#stop` once after the server has shut down or
    # the master has been killed. A launcher may attach a worker later than `#start`, through `Master#job_queue`,
    # because the master keeps the type check jobs until a typecheck worker is attached.
    #
    interface _WorkerLauncher
      def start: (Master master) -> void

      def stop: () -> void

      # Called on the main thread of the master when file changes are handed to the environment thread
      #
      # `signature_changed` tells whether the RBS environment is going to change.
      #
      def environment_changing: (Master master, signature_changed: bool) -> void

      # Called on the environment thread of the master after the changes are applied to the environment
      #
      # `versions` are the versions of the file contents the environment reflects, by relative path.
      #
      def environment_updated: (Master master, signature_changed: bool, versions: Hash[Pathname, Integer]) -> void
    end

    # Spawns each worker as a `steep worker` process at `Master#start`
    #
    # Each worker loads the RBS environment by itself, and the master sends the changed RBS files to the workers
    # before the requests, so the environment updates of the master need nothing from the launcher.
    #
    class SpawnLauncher
      include _WorkerLauncher

      attr_reader steepfile: Pathname?

      attr_reader steep_command: String?

      # The number of typecheck workers
      attr_reader typecheck_count: Integer

      # Whether to start the interaction worker
      attr_reader interaction: bool

      # The command line patterns given to the typecheck workers
      attr_reader patterns: Array[String]

      def initialize: (
        steepfile: Pathname?,
        steep_command: String?,
        typecheck_count: Integer,
        interaction: bool,
        ?patterns: Array[String]
      ) -> void
    end
  end
end
