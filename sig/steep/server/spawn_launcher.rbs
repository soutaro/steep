module Steep
  module Server
    # Starts each typecheck worker as a `steep worker` process
    #
    # The master calls `#start` right after the project is loaded on the `initialize` request. The workers load the RBS
    # environments by themselves, so the environments of the master are not used.
    #
    class SpawnLauncher
      attr_reader steepfile: Pathname?

      # The command to run the workers with, `nil` to fork this process or run `steep`
      attr_reader steep_command: String?

      # The number of typecheck workers
      attr_reader typecheck_count: Integer

      # The typecheck workers, empty before `#start`
      attr_reader typecheck_workers: Array[WorkerProcess]

      def initialize: (
        steepfile: Pathname?,
        steep_command: String?,
        typecheck_count: Integer
      ) -> void

      # Starts the workers
      def start: (Services::TypeCheckService) -> void

      # Releases what the launcher keeps besides the workers
      #
      # The master stops the workers itself, with `exit` or by killing them.
      #
      def stop: () -> void
    end
  end
end
