use LanguageServer::Protocol::Interface::Diagnostic as LSPDiagnostic

module Steep
  module Server
    # Defines custom LSP methods
    module CustomMethods
      # Notification with the latest contents of files, sent from master to a worker
      #
      # The master sends a worker the files it needs right before a type check or an interaction request.
      # See `Master#deliver_contents`.
      #
      module FileLoad
        METHOD: String

        type params = {
          content: Hash[String, ChangeBuffer::content]
        }

        def self.notification: (params) -> untyped
      end

      # Request to start type checking, sent from client to master
      #
      # This request is only used for non-interactive sessions.
      # The client is responsible to specify the files to be type checked.
      #
      module TypeCheck
        METHOD: String

        type target_path_string = [String, String]

        type params = {
          library_paths: Array[target_path_string],
          signature_paths: Array[target_path_string],
          inline_paths: Array[target_path_string],
          code_paths: Array[target_path_string]
        }

        type result = {
          guid: String,             # The unique identifier of the type checking session
          completed: bool,          # `true` if the type checking is completed
          started_at: String,       # The ISO-8061 time when the type checking started
          finished_at: String,      # The ISO-8601 time when the type checking finished
          duration: Integer         # Duration in seconds of the type checking
        }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result) -> untyped
      end

      # Notification to start type checking groups
      #
      # This notification is assumed to be sent from the LSP client -- an editor.
      #
      module TypeCheckGroups
        METHOD: String

        # Name of groups and targets to type check
        #
        # An empty array means every targets.
        #
        type params = {
          groups: Array[String]
        }

        def self.notification: (params) -> untyped
      end

      # Request to type check or validate one file, sent from the master to a typecheck worker
      #
      # The master hands the files of a type check to the workers one by one, and each worker answers with the
      # result of the file. `kind` tells what to do with the file: `code` type checks a Ruby file, `signature`
      # validates an RBS file of the project, `library` validates an RBS file of a library, and `inline` type checks
      # a Ruby file with inline RBS declarations and validates the declarations.
      #
      # `content` is the latest content of a Ruby file, given when the worker doesn't have it yet. The RBS files reach
      # the workers by `$/steep/file/load` before the type check.
      #
      module TypeCheck__File
        METHOD: String

        type kind = "code" | "signature" | "library" | "inline"

        type params = {
          guid: String,
          kind: kind,
          target: String,
          uri: String,
          ?content: ChangeBuffer::content
        }

        # The result of type checking Ruby code or validating RBS declarations in the file
        #
        # `diagnostics` is `nil` when the type checking is skipped, and `entries` is `nil` when no entries
        # are available. The master keeps the ones of the last result in either case. `stats` counts the
        # method calls of Ruby code for `$/steep/stats`, and is `nil` for RBS declarations or when the
        # file is not type checked.
        #
        type file_result = { diagnostics: Array[LSPDiagnostic::json]?, entries: Array[TypeCheckDatabase::Entry::wire]?, stats: Services::StatsCalculator::calls? }

        # `source` is the result of type checking Ruby code, and `signature` is the result of validating RBS declarations.
        # A Ruby file with inline RBS declarations has both.
        #
        type result = { source: file_result?, signature: file_result? }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result) -> untyped
      end

      # Request to start stats of type checking, sent from client to master and master to workers
      #
      # Request for the stats of the method calls in the type checked files, answered by the master from its `TypeCheckDatabase`
      #
      module Stats
        METHOD: String

        def self.request: (String id) -> untyped

        type result = Array[Services::StatsCalculator::json_stats]

        def self.response: (String id, result) -> untyped
      end

      # Request to get the list of groups and targets in the project
      #
      # The result will be like the following:
      #
      # * `lib`, `app`, `test`: names of targets
      # * `lib.core`, `app.frontend`, `test.unit`: names of targets and groups, concatenated by `.`
      #
      module Groups
        METHOD: String

        type result = Array[String]

        def self.response: (String id, result) -> untyped
      end

      # Request to resolve the definition(s) of a name (class, module, type alias, constant, or method)
      #
      # Used by `steep query definition NAME`. The master broadcasts the request to every
      # typecheck worker; each worker returns the locations it knows about and the master
      # merges and deduplicates the results.
      #
      module Query__Definition
        METHOD: String

        type params = {
          name: String
        }

        type source = "rbs" | "ruby"

        type location = {
          uri: String,
          range: {
            start: { line: Integer, character: Integer },
            end: { line: Integer, character: Integer }
          },
          source: source
        }

        type kind = "type_name" | "instance_method" | "singleton_method" | "unknown"

        type result = { name: String, kind: kind, locations: Array[location] }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result) -> untyped
      end

      # Position in a file and range of text, in the LSP convention -- zero-based lines and characters
      type position = { line: Integer, character: Integer }

      type range = { start: position, end: position }

      # Request for the hover content at a position, sent from master to the interaction worker
      #
      # The interaction worker type checks the file on demand and returns what is at the position. It sends the
      # types as strings and the declarations as names -- `::Foo`, `::Foo#bar`, or `::Foo.bar` -- because the
      # master resolves the names in its own environment when it renders the documentation. No declaration nor
      # comment travels between the processes.
      #
      module Hover
        METHOD: String

        type params = {
          uri: String,
          position: position
        }

        # A local variable: its name and type
        type variable_content = { kind: "variable", name: String, type: String }

        # An expression: its type
        type type_content = { kind: "type", type: String }

        # A type assertion: the type of the expression and the asserted type
        type type_assertion_content = { kind: "type_assertion", original_type: String, asserted_type: String }

        # A method call
        #
        # `return_type` is the type of the call, `nil` when no method type is compatible with the call (`error`).
        # `method_types` are the types of the definitions and `methods` their names, in the same order.
        # `special` tells that a custom typing rule applies.
        #
        type method_call_content = {
          kind: "method_call",
          return_type: String?,
          special: bool,
          error: bool,
          method_types: Array[String],
          methods: Array[String]
        }

        # A method definition: the name of the definition, the method type being checked, and the ones declared
        type definition_content = { kind: "definition", method: String, method_type: String, method_types: Array[String] }

        # A constant: its name
        type constant_content = { kind: "constant", name: String }

        # A class, module, interface, or type alias written in a type: its name
        type type_name_content = { kind: "type_name", name: String }

        # What is at the position, told apart by `kind`
        type content = variable_content
                     | type_content
                     | type_assertion_content
                     | method_call_content
                     | definition_content
                     | constant_content
                     | type_name_content

        # `target` is the name of the target the file belongs to, and `range` is the text the content is about
        type result = {
          target: String,
          range: range,
          content: content
        }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result?) -> untyped
      end

      # Request for the completion items at a position, sent from master to the interaction worker
      #
      # The worker returns the candidates, and the master renders them with the documentation from its environment.
      #
      module Completion
        METHOD: String

        type params = {
          uri: String,
          position: position,
          trigger: String?
        }

        # A local variable: `name` is the text to insert, and `range` the text it replaces
        type local_variable_item = { kind: "local_variable", range: range, name: String, type: String }

        # An instance variable
        type instance_variable_item = { kind: "instance_variable", range: range, name: String, type: String }

        # A constant: `full_name` is the name of the constant
        type constant_item = { kind: "constant", range: range, name: String, full_name: String }

        # A method: `method_types` are the overloads, and `methods` the names of the definitions, empty for a
        # method generated for the receiver type
        type method_item = { kind: "method", range: range, name: String, method_types: Array[String], methods: Array[String] }

        # A keyword argument: `name` has the trailing colon
        type keyword_argument_item = { kind: "keyword_argument", range: range, name: String }

        # A type name: `full_name` is the name of the type
        type type_name_item = { kind: "type_name", range: range, name: String, full_name: String }

        # A builtin type of RBS, like `untyped`
        type builtin_type_item = { kind: "builtin_type", range: range, name: String }

        # A snippet
        type text_item = { kind: "text", range: range, label: String, text: String, help_text: String? }

        # A completion candidate, told apart by `kind`
        type item = local_variable_item
                  | instance_variable_item
                  | constant_item
                  | method_item
                  | keyword_argument_item
                  | type_name_item
                  | builtin_type_item
                  | text_item

        # `incomplete` tells that the environment has an error and the items may be incomplete
        type result = {
          target: String,
          incomplete: bool,
          items: Array[item]
        }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result?) -> untyped
      end

      # Request for the signature help at a position, sent from master to the interaction worker
      #
      module SignatureHelp
        METHOD: String

        type params = {
          uri: String,
          position: position
        }

        # `method_type` is an overload of the method being called, `parameters` are its parameters in the order of
        # the signature, `active_parameter` is the index of the parameter at the position, and `method` is the
        # name of the definition, absent for a method without definition
        type signature = {
          method_type: String,
          parameters: Array[String],
          active_parameter: Integer?,
          method: String?
        }

        # `active_signature` is the index of the overload the call is resolved to
        type help = { target: String, signatures: Array[signature], active_signature: Integer? }

        # `signature_help` is `nil` when the position is not in the arguments of a method call, and `syntax_error`
        # tells that the file cannot be parsed, so that the master keeps showing the last signature help while the
        # user types
        type result = { signature_help: help?, syntax_error: bool }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result?) -> untyped
      end

      # Request to resolve what is at a cursor position, sent from master to the interaction worker
      #
      # The interaction worker type checks the file on demand, like hover, and returns what is at the position.
      # The master looks the names up in its `TypeCheckDatabase` to answer goto requests -- `constant`,
      # `type_name`, and `method_names` for definition and implementation, and the type names in `type` for
      # typeDefinition.
      #
      module Source__Symbol
        METHOD: String

        type params = {
          uri: String,
          position: { line: Integer, character: Integer }
        }

        # What is at the position, each key present only when there is one
        #
        # * `constant` is the constant written at the position -- `::Foo`, referenced or defined in Ruby code, or
        #   declared in an RBS file
        # * `type_name` is the type name written in a type at the position -- `::Foo`, `::_Foo`, or `::foo`, in an
        #   RBS file, a type annotation, or an inline RBS declaration
        # * `method_names` are the methods written at the position -- `::Foo#bar` or `::Foo.bar`, resolved to the
        #   names they are declared as, which may be several for a call on a union type
        # * `type` is the type of the expression at the position in RBS syntax, absent in RBS files
        #
        type result = {
          ?constant: String,
          ?type_name: String,
          ?method_names: Array[String],
          ?type: String
        }

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result) -> untyped
      end

      module Query__Diagnostics
        METHOD: String

        type params = {
          paths: Array[String]?
        }

        # Diagnostics of a file
        #
        # `diagnostics` is `nil` when the server has not type checked the file yet.
        #
        type entry = { uri: String, diagnostics: Array[untyped]? }

        # The master answers from its `TypeCheckDatabase`, with `diagnostics: nil` entries for
        # requested files it has no result of.
        #
        type result = Array[entry]

        def self.request: (String id, params) -> untyped

        def self.response: (String id, result) -> untyped
      end
    end
  end
end
