use Steep::Services::*, LanguageServer::Protocol as LSP
use LanguageServer::Protocol::Interface::Diagnostic as LSPDiagnostic

module Steep
  module Server
    # TypeCheckWorker type checks and validates one file at a time, requested by `$/steep/typecheck/file`
    #
    # Each request becomes a *job*, and the response carries the result of the file.
    #
    # * `ValidateAppSignatureJob` validates an *application* RBS file
    # * `ValidateLibrarySignatureJob` validates a *library* RBS file
    # * `TypeCheckCodeJob` type checks a ruby code
    # * `TypeCheckInlineCodeJob` type checks a Ruby file with inline RBS declarations, and validates the declarations
    # * `IndexSignatureJob` reports the declarations in an RBS file (or the inline RBS declarations in a Ruby file)
    #   without validating them
    #
    # The contents delivered by `$/steep/file/load` and with the requests are applied to the `TypeCheckService`
    # right before each job.
    #
    class TypeCheckWorker < BaseWorker
      attr_reader project: Project

      @service: TypeCheckService?

      # The environments and the source files, loaded on the first call unless the worker is forked with them
      def service: () -> TypeCheckService

      class TypeCheckCodeJob
        # The id of the `$/steep/typecheck/file` request
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader target: Project::Target

        def initialize: (id: String, path: Pathname, target: Project::Target) -> void
      end

      class ValidateAppSignatureJob
        # The id of the `$/steep/typecheck/file` request
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader target: Project::Target

        def initialize: (id: String, path: Pathname, target: Project::Target) -> void
      end

      class ValidateLibrarySignatureJob
        # The id of the `$/steep/typecheck/file` request
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader target: Project::Target

        def initialize: (id: String, path: Pathname, target: Project::Target) -> void
      end

      class TypeCheckInlineCodeJob
        # The id of the `$/steep/typecheck/file` request
        attr_reader id: String

        attr_reader path: Pathname

        attr_reader target: Project::Target

        def initialize: (id: String, path: Pathname, target: Project::Target) -> void
      end

      # Reports the entries of the declarations in the file, of the library, the RBS files, or the inline RBS
      # declarations of the project, without validating them
      class IndexSignatureJob
        # The id of the `$/steep/typecheck/file` request
        attr_reader id: String

        # The absolute path of the file
        attr_reader path: Pathname

        attr_reader target: Project::Target

        def initialize: (id: String, path: Pathname, target: Project::Target) -> void
      end

      # The queue of the jobs
      def queue: () -> Thread::Queue[job]

      attr_reader mutex: Mutex

      # The entries of the declarations in the latest environment of each target, grouped by path
      #
      # The environment is kept with the entries to detect a newer environment of the target.
      #
      @rbs_entries_cache: Hash[Symbol, [RBS::Environment, Hash[Pathname, Array[TypeCheckDatabase::Entry]]]]

      include ChangeBuffer

      # `service` is the environments the worker starts with, given by forking the master, and the worker loads them
      # by itself without it
      def initialize: (
        project: Project,
        reader: LSP::Transport::Io::Reader,
        writer: LSP::Transport::Io::Writer,
        ?service: Services::TypeCheckService?
      ) -> void

      def handle_request: (untyped request) -> void

      # Enqueues the job of a `$/steep/typecheck/file` request, loading the content given with the request
      def enqueue_typecheck_job: (String id, CustomMethods::TypeCheck__File::params params) -> void

      type job = TypeCheckCodeJob
               | ValidateAppSignatureJob
               | ValidateLibrarySignatureJob
               | TypeCheckInlineCodeJob
               | IndexSignatureJob

      # Runs a job and writes its response, after applying the buffered changes to the service
      def handle_job: (job) -> void

      # Applies the buffered changes to the service, before a job runs
      def apply_changes: () -> void

      # The result of type checking Ruby code or validating RBS declarations in a file, to be reported to the master
      #
      # `diagnostics` is `nil` when the type checking is skipped, and `entries` is `nil` when no entries are available.
      # `stats` counts the method calls of Ruby code, and is `nil` when the file is not type checked or for RBS declarations.
      #
      type result = { diagnostics: Array[LSPDiagnostic::json]?, entries: Array[TypeCheckDatabase::Entry]?, stats: StatsCalculator::calls? }

      # Answers a `$/steep/typecheck/file` request with the results of the file
      #
      # `source` is the result of type checking Ruby code, and `signature` is the result of validating RBS declarations.
      # A Ruby file with inline RBS declarations reports both.
      #
      def respond: (String id, ?source: result?, ?signature: result?) -> void

      def wire_result: (result) -> CustomMethods::TypeCheck__File::file_result

      # Returns the result to report for a type checked Ruby file -- the diagnostics, the entries, and the stats from its `Typing`
      #
      # Everything is `nil` when the type checking is skipped (`file` is `nil`), and the entries and the stats are `nil`
      # when the file has no `Typing` because of a syntax error.
      #
      def source_result: (TypeCheckService::SourceFile? file, Diagnostic::LSPFormatter formatter) -> result

      # Returns the declarations in the RBS file (or the inline RBS in the Ruby file) of the target
      #
      # `path` is the relative path of a project file, or the absolute path of a library file, which is the
      # name of the buffer of the declarations.
      #
      # Returns `nil` when the signatures of the target failed to load, because the index would be of the last
      # successfully loaded signatures, and its locations may be stale.
      #
      def signature_entries: (Project::Target target, Pathname path) -> Array[TypeCheckDatabase::Entry]?
    end
  end
end
