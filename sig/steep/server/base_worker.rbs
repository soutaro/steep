module Steep
  module Server
    # The common part of the workers: reads the messages from the master, and runs the jobs in a background thread
    #
    # A worker takes requests from the moment it starts, and stops at the `exit` notification, or when the master
    # closes the pipe. The running job finishes, the jobs left in the queue are skipped, and the process exits.
    #
    class BaseWorker
      interface _Queue[A]
        def pop: () -> A?

        def <<: (A) -> A

        def close: () -> void
      end

      module LSP = LanguageServer::Protocol

      # `true` once the worker is stopping: the jobs left in the queue are skipped
      @skip_job: bool

      attr_reader project: Project

      attr_reader reader: LanguageServer::Protocol::Transport::Io::Reader

      attr_reader writer: LanguageServer::Protocol::Transport::Io::Writer

      attr_reader queue: _Queue[untyped]

      def initialize: (project: Project, reader: LanguageServer::Protocol::Transport::Io::Reader, writer: LanguageServer::Protocol::Transport::Io::Writer) -> void

      def skip_job?: () -> bool

      def handle_request: (untyped request) -> void

      def handle_job: (untyped job) -> void

      def run: () -> void
    end
  end
end
