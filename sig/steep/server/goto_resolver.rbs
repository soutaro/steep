module Steep
  module Server
    # GotoResolver answers goto requests and `$/steep/query/definition` from the `TypeCheckDatabase`
    #
    # What is at the cursor position comes from the interaction worker (`$/steep/source/symbol`) -- the constant,
    # the type name, or the methods written there, and the type of the expression there -- and the resolver looks
    # the definitions up in the database, applying the same policy as `Services::GotoService`:
    #
    # * *Go to definition* on a constant or a method jumps from Ruby code to the RBS declarations, and from an RBS file to the Ruby definitions
    # * *Go to definition* on a type name jumps to its RBS declarations, wherever the type name is written
    # * *Go to implementation* jumps to the Ruby definitions
    # * *Go to type definition* jumps to the RBS declarations of the type names in the type of the expression
    # * `Foo.new` falls back to `Foo#initialize` when there is no definition of `new`
    #
    class GotoResolver
      type location = { uri: String, range: TypeCheckDatabase::Location::lsp_range }

      # The goto request being answered
      type kind = :definition | :implementation | :type_definition

      # Whether the cursor is in Ruby code (including inline RBS declarations) or in an RBS file
      type from = :ruby | :rbs

      attr_reader database: TypeCheckDatabase

      def initialize: (database: TypeCheckDatabase) -> void

      # Returns the LSP locations for a goto request, given the result of `$/steep/source/symbol` and where the cursor is
      def goto: (kind: kind, from: from, result: CustomMethods::Source__Symbol::result) -> Array[location]

      # Returns the result of `$/steep/query/definition` for a name string
      def query_definition: (String name_string) -> CustomMethods::Query__Definition::result

      # Yields the type names in a type in RBS syntax, once each
      #
      # Literal types, `nil`, and `bool` yield the names of their classes. Names that are not absolute
      # -- type variables, in practice -- are skipped, as are types that fail to parse.
      #
      def each_type_name: (String type_string) { (RBS::TypeName) -> void } -> void

      private

      def collect_type_names: (RBS::Types::t type, Array[RBS::TypeName] names) -> void

      # Returns the absolute name of a class in the root namespace
      def builtin_name: (Symbol name) -> RBS::TypeName

      def definition_locations: (RBS::TypeName | String name, source: TypeCheckDatabase::Location::source) -> Array[location]

      def method_definition_locations: (String name, source: TypeCheckDatabase::Location::source) -> Array[location]

      # Returns the definitions of a method, in the `source` if given, falling back to `#initialize` for `.new`
      def method_definitions: (String name, ?source: TypeCheckDatabase::Location::source?) -> Array[TypeCheckDatabase::Location]

      def filter_source: (Array[TypeCheckDatabase::Location] locations, TypeCheckDatabase::Location::source? source) -> Array[TypeCheckDatabase::Location]

      def lsp_location: (TypeCheckDatabase::Location location) -> location

      def query_location: (TypeCheckDatabase::Location location) -> CustomMethods::Query__Definition::location
    end
  end
end
