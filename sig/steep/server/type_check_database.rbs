module Steep
  module Server
    # TypeCheckDatabase stores the results of type checking that the master process keeps
    #
    # The typecheck workers report the results of each file through `$/steep/typecheck/progress` notifications,
    # and the master process saves them in this database, so that it can answer queries without
    # the workers keeping the `Typing` objects in memory.
    #
    # It stores LSP formatted diagnostics and the definitions and references of methods, constants, and RBS type names
    # with their locations, in three tables:
    #
    # * *Sources* keeps the results of type checking Ruby code, keyed by the path -- a Ruby file belongs to exactly one target
    # * *Signatures* keeps the diagnostics of validating RBS declarations, keyed by the path and the target -- an RBS file
    #   is loaded in every target that references it
    # * *RBS* keeps the definitions and references in RBS declarations, keyed by the path and the target -- the names an
    #   RBS file references may resolve differently in each target
    #
    # The workers report the entries of RBS declarations when they validate a file, and when they index a file without
    # validating it: the library RBS files, and the RBS files of the groups not type checked. So a file may have entries
    # without being validated.
    #
    # A Ruby file with inline RBS declarations has its results in every table: the type checking of the Ruby code in
    # *sources*, the validation of the inline declarations in *signatures*, and the entries of the declarations in *RBS*.
    #
    # ```rb
    # database = TypeCheckDatabase.new()
    #
    # database.update_source(path: Pathname("lib/foo.rb"), target: :app, diagnostics: diagnostics, entries: entries)
    # database.update_signature(path: Pathname("sig/foo.rbs"), target: :app, diagnostics: diagnostics)
    # database.update_rbs(path: Pathname("sig/foo.rbs"), target: :app, entries: entries)
    #
    # database.diagnostics(Pathname("lib/foo.rb"))   # Diagnostics of the file, merged over the tables and the targets
    # database.definitions("::Foo#bar")              # Definitions of `Foo#bar` in the project
    # database.references("::Foo")                   # References of `Foo` in the project
    # database.matching_names("foo")                 # Names including `foo`, ignoring the case
    # database.rbs_definitions(["::Foo", "::Foo#bar"]) # RBS declarations of the names, for `workspace/symbol`
    # ```
    #
    # The queries return the locations in all targets, merged and deduplicated.
    #
    # The entries are stored in a flat `Array[Integer]` per file (and target), with names interned
    # in a `NamePool`, to minimize the memory footprint of the master process.
    #
    # The implementation is not thread safe, assuming every call is from the master's event loop.
    #
    class TypeCheckDatabase
      # Definition or reference of a method, constant, or RBS type name, reported by the workers
      #
      # * `name` is the fully qualified name of the entity -- a constant (`::Foo::Bar`), an instance method (`::Foo#bar`),
      #   a singleton method (`::Foo.bar`), an interface (`::_Foo`), a type alias (`::foo`), or a global variable (`$foo`),
      #   which tells the kind of the entity by its syntax
      # * The location is in LSP convention -- 0-origin lines and characters, end-exclusive
      # * `kind` is the kind of the declaration that an RBS definition entry comes from, and `nil` for the references and
      #   the definitions in Ruby code
      #
      class Entry
        # Whether the entry defines the name or references it
        type role = :definition | :reference

        # The kind of the RBS declaration -- a class alias is a `:class` and a module alias is a `:module`, and an
        # attribute is `:attribute` for both of its reader and writer methods
        type kind = :class | :module | :interface | :type_alias | :constant | :global | :method | :attribute

        attr_reader name: String

        attr_reader role: role

        attr_reader kind: kind?

        attr_reader start_line: Integer

        attr_reader start_character: Integer

        attr_reader end_line: Integer

        attr_reader end_character: Integer

        # Array representation of an entry for `$/steep/typecheck/progress` notifications
        #
        # `[name, code, start_line, start_character, end_line, end_character]`
        #
        type wire = Array[untyped]

        def initialize: (name: String, role: role, start_line: Integer, start_character: Integer, end_line: Integer, end_character: Integer, ?kind: kind?) -> void

        # The role and the kind in an `Integer` -- the lowest bit is the role, and the other bits are the kind, `0` for `nil`
        def code: () -> Integer

        def to_wire: () -> wire

        def self.from_wire: (wire array) -> Entry
      end

      # Location of a definition or reference, returned by the queries
      #
      # `source` tells whether the location is in Ruby code or in RBS declarations, which is not always
      # decidable from the path because of the inline RBS declarations in Ruby files.
      #
      class Location
        type source = :ruby | :rbs

        type lsp_range = { start: { line: Integer, character: Integer }, end: { line: Integer, character: Integer } }

        attr_reader path: Pathname

        attr_reader source: source

        attr_reader start_line: Integer

        attr_reader start_character: Integer

        attr_reader end_line: Integer

        attr_reader end_character: Integer

        def initialize: (path: Pathname, source: source, start_line: Integer, start_character: Integer, end_line: Integer, end_character: Integer) -> void

        def lsp_range: () -> lsp_range
      end

      # An RBS declaration found by `#rbs_definitions`
      class Definition
        attr_reader name: String

        attr_reader kind: Entry::kind

        attr_reader location: Location

        def initialize: (name: String, kind: Entry::kind, location: Location) -> void
      end

      # Interned strings with reference counting
      #
      # Each unique string is stored once and identified by an `Integer` id.
      # `#intern` increments the reference count of the string, and `#release` decrements it,
      # releasing the string when the count drops to zero.
      #
      class NamePool
        @ids: Hash[String, Integer]

        @names: Hash[Integer, String]

        @counts: Hash[Integer, Integer]

        @next_id: Integer

        def initialize: () -> void

        # Returns the id of the string, incrementing its reference count
        def intern: (String name) -> Integer

        # Decrements the reference count of the id, releasing the string when it drops to zero
        def release: (Integer id) -> void

        # Returns the string of the id, or `nil` if the id is not in the pool
        def []: (Integer id) -> String?

        # Returns the id of the string without changing its reference count, or `nil` if the string is not in the pool
        def id_of: (String name) -> Integer?

        # Number of the strings in the pool
        def size: () -> Integer

        # Yields the id and the string of each string in the pool
        def each: () { ([Integer, String]) -> void } -> void
      end

      # The result of the last type checking of a Ruby file
      class FileResult
        # The target the file is type checked in
        attr_reader target: Symbol

        attr_reader diagnostics: Array[untyped]

        # Packed entries
        attr_reader entries: Array[Integer]

        # The numbers of the method calls, `nil` when the file has no `Typing`
        attr_reader stats: Services::StatsCalculator::calls?

        def initialize: (target: Symbol, diagnostics: Array[untyped], entries: Array[Integer], stats: Services::StatsCalculator::calls?) -> void
      end

      ROLE_CODES: Hash[Entry::role, Integer]

      ROLES: Hash[Integer, Entry::role]

      KIND_CODES: Hash[Entry::kind, Integer]

      KINDS: Hash[Integer, Entry::kind]

      # Number of `Integer`s that represent one entry
      ENTRY_SIZE: Integer

      # Results of type checking Ruby code
      @sources: Hash[Pathname, FileResult]

      # Diagnostics of validating RBS declarations, of each path and target
      @signatures: Hash[Pathname, Hash[Symbol, Array[untyped]]]

      # Reference counts of names per path in `@sources` -- `name id => (path => count)`
      @source_paths: Hash[Integer, Hash[Pathname, Integer]]

      # Packed entries of RBS declarations, of each path and target
      @rbs: Hash[Pathname, Hash[Symbol, Array[Integer]]]

      # Reference counts of names per path in `@rbs`, over the targets -- `name id => (path => count)`
      @rbs_paths: Hash[Integer, Hash[Pathname, Integer]]

      # Extracts the entries of a type checked Ruby file from its `Typing`
      #
      # The constant definitions/references and method definitions come from the `SourceIndex`,
      # and the method references come from the method calls, resolved to the names of the
      # declarations of each call.
      #
      def self.entries_from: (Typing typing) -> Array[Entry]

      def self.constant_definition_location: (Parser::AST::Node node) -> Parser::Source::Range?

      def self.method_call_location: (Parser::AST::Node node) -> Parser::Source::Range?

      def self.push_entry: (Array[Entry] entries, Set[Array[untyped]] seen, name: String, role: Entry::role, location: Parser::Source::Range) -> void

      # Extracts the declarations and the type references in the RBS files (and inline RBS in Ruby files) of the environment,
      # grouped by the path of the file
      #
      # See `RBSEntryBuilder` for the details.
      #
      def self.rbs_entries_by_path: (RBS::Environment env) -> Hash[Pathname, Array[Entry]]

      attr_reader pool: NamePool

      def initialize: () -> void

      # Replaces the result of type checking the Ruby code in the file
      #
      # `diagnostics` or `entries` given `nil` keeps the ones of the last update, for the type checking that is skipped.
      # `stats` is kept too when `diagnostics` is `nil`, and replaced otherwise -- `nil` then means the file has no `Typing`.
      #
      def update_source: (path: Pathname, target: Symbol, diagnostics: Array[untyped]?, entries: Array[Entry]?, ?stats: Services::StatsCalculator::calls?) -> void

      # Replaces the diagnostics of validating the RBS declarations in the file, in the target
      #
      # `diagnostics` given `nil` keeps the ones of the last update, for the validation that is skipped.
      #
      def update_signature: (path: Pathname, target: Symbol, diagnostics: Array[untyped]?) -> void

      # Replaces the entries of the RBS declarations in the file, in the target
      #
      # `entries` given `nil` keeps the ones of the last update, for the signatures that fail to load.
      #
      # The entries are not the results of a validation: storing them doesn't make the file `checked?` nor puts it in
      # `paths`. They are found by `definitions` and `references` as `:rbs` locations.
      #
      def update_rbs: (path: Pathname, target: Symbol, entries: Array[Entry]?) -> void

      # Deletes everything stored for the `path`
      def remove: (Pathname path) -> void

      # Returns `true` if any result of the `path` is stored
      def checked?: (Pathname path) -> bool

      # Returns the paths with any result stored
      def paths: () -> Array[Pathname]

      # Yields the path and the result of each Ruby file
      def each_source: () { (Pathname, FileResult) -> void } -> void
                     | () -> Enumerator[[Pathname, FileResult], void]

      # Returns the diagnostics of the file, merged over the tables and the targets
      #
      # Returns an empty array when no result of the file is stored.
      #
      def diagnostics: (Pathname path) -> Array[untyped]

      # Returns the locations of the definitions of the name in the project
      #
      # The locations in Ruby code come first, followed by the ones in RBS declarations.
      #
      def definitions: (String name) -> Array[Location]

      # Returns the locations of the references of the name in the project
      #
      # The locations in Ruby code come first, followed by the ones in RBS declarations.
      #
      def references: (String name) -> Array[Location]

      # Returns the names in the database that include `query`, ignoring the case, or every name for `""`
      #
      # The names are the fully qualified names of the entries, like `::Foo::Bar#baz`, of the definitions and the
      # references in every table.
      #
      def matching_names: (String query) -> Array[String]

      # Returns the RBS declarations of the names
      #
      # The declarations are the definition entries with a kind, in the *RBS* table, and one found in several targets is
      # returned once. The files that have the names are read once for all of the names.
      #
      def rbs_definitions: (Array[String] names) -> Array[Definition]

      # Number of entries stored in the database
      def entry_count: () -> Integer

      private

      # Returns the result that replaces `old`, packing `entries` and keeping the parts of `old` given `nil`
      def replace_result: (FileResult? old, Hash[Integer, Hash[Pathname, Integer]] name_paths, path: Pathname, target: Symbol, diagnostics: Array[untyped]?, entries: Array[Entry]?, stats: Services::StatsCalculator::calls?) -> FileResult

      def pack_entries: (Hash[Integer, Hash[Pathname, Integer]] name_paths, Pathname path, Array[Entry] entries) -> Array[Integer]

      def matching_locations: (String name, role: Entry::role) -> Array[Location]

      # Appends the locations of the entries of the name and the role (the code of the role, without the kind) in the
      # packed `array` to `locations`
      def collect_locations: (Array[Location] locations, Array[Integer] array, Integer id, Integer role_code, path: Pathname, source: Location::source) -> void

      def release_entries: (Hash[Integer, Hash[Pathname, Integer]] name_paths, Pathname path, Array[Integer] array) -> void

      def track_name: (Hash[Integer, Hash[Pathname, Integer]] name_paths, Integer id, Pathname path) -> void

      def untrack_name: (Hash[Integer, Hash[Pathname, Integer]] name_paths, Integer id, Pathname path) -> void
    end
  end
end
