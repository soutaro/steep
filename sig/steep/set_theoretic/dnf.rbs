module Steep
  module SetTheoretic
    # The disjunctive normal form of a type: a union of clauses, each the intersection of atoms and negated atoms
    class DNF
      # The bound on the number of clauses of a product
      MAX_CLAUSES: Integer

      # Raised when the DNF of a type has too many clauses to build
      class TooLarge < StandardError
      end

      class Clause
        attr_reader positives: Set[AST::Types::t]

        attr_reader negatives: Set[AST::Types::t]

        def initialize: (positives: Set[AST::Types::t], negatives: Set[AST::Types::t]) -> void

        def self.top: () -> Clause

        def &: (Clause other) -> Clause

        # `true` if an atom is both required and excluded, so that the clause is `bot` syntactically
        def contradiction?: () -> bool

        def top?: () -> bool

        def size: () -> Integer

        # `true` if every value of `other` is a value of this clause syntactically: the atoms of this clause are
        # among the atoms of `other`
        def subsumes?: (Clause other) -> bool

        def ==: (untyped other) -> bool

        alias eql? ==

        def hash: () -> Integer

        def to_type: () -> AST::Types::t

        def to_s: () -> String
      end

      attr_reader clauses: Array[Clause]

      def initialize: (Array[Clause] clauses) -> void

      def self.bot: () -> DNF

      def self.top: () -> DNF

      def self.atom: (AST::Types::t type) -> DNF

      def self.negated_atom: (AST::Types::t type) -> DNF

      # The clauses without the duplicates, the contradictions, and the ones another clause subsumes, in their order
      def self.prune: (Array[Clause] clauses) -> Array[Clause]

      def bot?: () -> bool

      def top?: () -> bool

      def |: (DNF other) -> DNF

      # Raises `TooLarge` when the product has more than `MAX_CLAUSES` clauses
      def &: (DNF other) -> DNF

      # De Morgan: `!(C1 | C2)` is `!C1 & !C2`, and `!(p1 & p2 & !n1)` is `!p1 | !p2 | n1`
      def negate: () -> DNF

      def to_type: () -> AST::Types::t

      def to_s: () -> String

      def ==: (untyped other) -> bool

      alias eql? ==

      def hash: () -> Integer
    end

    # Builds the DNF of a type
    class Normalizer
      attr_reader factory: AST::Types::Factory

      # `false` keeps the aliases as atoms
      attr_reader expand_aliases: bool

      @cache: Hash[[AST::Types::t, bool], DNF]

      def initialize: (factory: AST::Types::Factory, ?expand_aliases: bool) -> void

      # `expanding` is the set of the aliases being unfolded, to keep a cyclic alias opaque, and `negated` is `true`
      # under an odd number of negations
      #
      # The DNFs are immutable, so that the normalization of a type is computed once
      def normalize: (AST::Types::t type, ?Set[RBS::TypeName] expanding, ?bool negated) -> DNF

      def normalize0: (AST::Types::t type, Set[RBS::TypeName] expanding, bool negated) -> DNF

      def atom: (AST::Types::t type, bool negated) -> DNF
    end
  end
end
